--- 无尽模式：动态生成第6关及以后的关卡配置
function M.GetLevelConfig(levelNum)
    if levelNum <= #M.LEVELS then
        return M.LEVELS[levelNum]
    end
    local extraLevels = levelNum - #M.LEVELS
    local pairs = math.min(6 + extraLevels, #M.COLORS)
    local showTime = math.max(0.5, 1.5 - extraLevels * 0.1)
    local label = string.format("第%d关 · 无尽", levelNum)
    return { pairs = pairs, showTime = showTime, label = label }
end

return M
