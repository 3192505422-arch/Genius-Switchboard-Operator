                },
            },
            -- 右侧：对话气泡
            UI.Panel {
                width = "45%", height = "85%",
                justifyContent = "center",
                alignItems = "flex-start",
                paddingLeft = 10,
                children = {
                    UI.Panel {
                        width = "100%",
                        padding = 24,
                        gap = 14,
                        children = {
                            UI.Panel {
                                position = "absolute",
                                left = -200, top = -30, right = -30, bottom = -40,
                                backgroundImage = "image/dialog_bubble.png",
                                backgroundSize = "stretch",
                                pointerEvents = "box-none",
                            },
                            UI.Label {
                                text = page.text,
                                fontSize = 18,
                                fontColor = { 60, 30, 25, 255 },
