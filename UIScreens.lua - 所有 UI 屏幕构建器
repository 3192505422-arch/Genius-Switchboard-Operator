function M.CreateMenuScreen()
    local game = G.game
    local dpr = graphics:GetDPR()
    local scrH = graphics:GetHeight() / dpr

    local children = {}

    -- 左侧角色头顶的鸟
    children[#children + 1] = UI.Panel {
        position = "absolute",
        left = "6%",
        bottom = "66%",
        width = "20%", height = "20%",
        backgroundImage = "image/menu_bird.png",
        backgroundFit = "contain",
        pointerEvents = "box-none",
        zIndex = 6,
    }

    -- 左侧角色（老板）
    children[#children + 1] = UI.Panel {
        position = "absolute",
        left = "0%",
        bottom = "0%",
        width = "36%", height = "72%",
        backgroundImage = "image/menu_char_left.png",
        backgroundFit = "contain",
        backgroundPosition = "left bottom",
        pointerEvents = "box-none",
        zIndex = 5,
    }

    -- 右侧角色（耳朵）
    children[#children + 1] = UI.Panel {
        position = "absolute",
        right = "0%",
        bottom = "0%",
        width = "36%", height = "72%",
        backgroundImage = "image/menu_char_right.png",
        backgroundFit = "contain",
        backgroundPosition = "right bottom",
        pointerEvents = "box-none",
        zIndex = 5,
    }

    -- 简历卡片
    if not game.menuAutoSlide or game.menuResumeOffsetY < scrH then
        children[#children + 1] = UI.Panel {
            position = "absolute",
            left = "8%",
            top = math.floor(-game.menuResumeOffsetY),
            width = "84%", height = "112%",
            marginTop = "3%",
            backgroundImage = "image/opening_resume.png",
            backgroundFit = "contain",
            zIndex = 10,
        }
    end

    return UI.Panel {
        width = "100%", height = "100%",
        backgroundImage = "image/opening_bg.png",
        backgroundSize = "cover",
        pointerEvents = "box-none",
        children = children,
    }
end

