function M.CreateIntroScreen()
    local game = G.game
    local page = Dialogue.INTRO_PAGES[game.introPage]
    local isLast = (game.introPage >= #Dialogue.INTRO_PAGES)
    local hintText = isLast and "点击进入关卡" or "点击继续..."

    return UI.Panel {
        width = "100%", height = "100%",
        backgroundColor = { 0, 0, 0, 0 },
        flexDirection = "row",
        justifyContent = "center",
        alignItems = "center",
        onClick = function(self)
            if game.introPage < #Dialogue.INTRO_PAGES then
                game.introPage = game.introPage + 1
                if G.RebuildGameUI then G.RebuildGameUI() end
            else
                game.introPage = 1
                if G.InitLevel then G.InitLevel(1) end
