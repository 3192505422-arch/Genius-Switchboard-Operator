local PHONE_EARPIECE_SIZE = Config.PHONE_EARPIECE_SIZE

-- 内部辅助：连接检查（避免 require DragInput 循环依赖）
local function isLeftConnected(leftIdx)
    for _, pc in ipairs(G.game.playerConnections) do
        if pc.leftIdx == leftIdx then return true end
    end
    return false
end

local function isRightConnected(rightIdx)
    for _, pc in ipairs(G.game.playerConnections) do
        if pc.rightIdx == rightIdx then return true end
    end
    return false
end

